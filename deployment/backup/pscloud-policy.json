{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UploaderBucketReadOnly",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:GetBucketObjectLockConfiguration",
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": "arn:aws:s3:::oxus-prod-backups-locked",
      "Condition": {
        "StringEquals": {
          "aws:username": "a74e83900e1eae5c7dd2d3fe889127f4"
        }
      }
    },
    {
      "Sid": "ManagedEncryptedCheckpoints",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:GetObjectRetention",
        "s3:PutObjectRetention",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::oxus-prod-backups-locked/oxus-backup/v1/production/*",
      "Condition": {
        "StringEquals": {
          "aws:username": "a74e83900e1eae5c7dd2d3fe889127f4"
        }
      }
    }
  ]
}
