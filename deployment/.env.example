# Backend-only server template. Copy to deployment/.env on each server.
# Keep the real file on the server only; never commit it to Git.

# Image and environment
BACKEND_IMAGE=ghcr.io/zhunus1/oxus_backend:test
STAGING=true
TZ=Asia/Almaty

# Loopback ports consumed by the host Nginx reverse proxy
BACKEND_PORT=4000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9090

# Public URLs
APP_URL=https://test.oxusedu.com
FRONTEND_URL=https://test.oxusedu.com
EXPERT_DASHBOARD_URL=https://expert.test.oxusedu.com/collab-meetings

# Authentication: generate independent, long random values for each secret
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# PostgreSQL: use URL-safe values because these are also composed into DATABASE_URL
POSTGRES_DB=oxusedu
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-url-safe-database-password

# Redis: use a URL-safe value because this is also composed into REDIS_URL
REDIS_PASSWORD=replace-with-a-url-safe-redis-password

# S3-compatible object storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-a-minio-access-key
AWS_SECRET_ACCESS_KEY=replace-with-a-long-minio-secret-key
AWS_BUCKET_NAME=uploads
AWS_MINIO_PUBLIC_URL=https://test.oxusedu.com/storage

# Jitsi/JaaS. The private key is stored separately as jitsi-private-key.pk.
JITSI_APP_ID=replace-with-a-test-jitsi-app-id
JAAS_API_KEY_ID=replace-with-a-test-jaas-api-key-id
JITSI_DOMAIN=8x8.vc

# AI providers
OPENAI_API_KEY=
OPENAI_PROGRAM_SYNC_MODEL=gpt-4.1-mini
GEMINI_API_KEY=

# Email
SENDER_EMAIL=no-reply@oxusedu.com
SENDER_PASSWORD=
SMTP_PORT=587
SMTP_SERVER=smtp.example.com
SMTP_SECURE=false

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# Freedom Pay
FREEDOM_API_URL=
FREEDOM_MERCHANT_ID=
FREEDOM_RECEIVE_SECRET_KEY=
FREEDOM_PAYMENT_SECRET_KEY=
FREEDOM_RESULT_URL=https://test.oxusedu.com/api/v1/billing/result
FREEDOM_FAILURE_URL=https://test.oxusedu.com/payment/failure
FREEDOM_SUCCESS_URL=https://test.oxusedu.com/payment/success
