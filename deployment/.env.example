# Server template for Test or Production. Keep the real .env only on that server.
# Release and registry
APP_RELEASE=latest
REGISTRY_URL=registry.example.com

# Public URLs and gateway ports
APP_URL=https://example.com
NGINX_PORT=4000
NGINX_EXPERT_PORT=4001
NGINX_ADMIN_PORT=4002

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# PostgreSQL
PGDATABASE=oxusedu
PGHOST=oxusedu-db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_PORT=5432

# Redis
REDIS_HOST=oxusedu-redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-redis-password

# S3-compatible storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-an-access-key
AWS_S3_BUCKET_NAME=uploads
AWS_SECRET_ACCESS_KEY=replace-with-a-secret-key
AWS_MINIO_ENDPOINT=http://oxusedu-minio:9000
AWS_MINIO_PUBLIC_URL=https://example.com/storage

# AI providers
OPENAI_API_KEY=
GEMINI_API_KEY=

# Email
SENDER_EMAIL=no-reply@example.com
SENDER_PASSWORD=
SMTP_PORT=587
SMTP_SERVER=smtp.example.com
SMTP_SECURE=false

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# Jitsi
JITSI_APP_ID=
JAAS_API_KEY_ID=

# Freedom Pay
FREEDOM_API_URL=https://api.example.com
FREEDOM_MERCHANT_ID=
FREEDOM_RECEIVE_SECRET_KEY=
FREEDOM_PAYMENT_SECRET_KEY=
FREEDOM_RESULT_URL=https://example.com/api/v1/billing/result
FREEDOM_FAILURE_URL=https://example.com/payment/failure
FREEDOM_SUCCESS_URL=https://example.com/payment/success
