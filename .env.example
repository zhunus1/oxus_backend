# Copy to .env only for local development. Never place server secrets here.
# Local Docker host ports
LOCAL_BACKEND_PORT=4000
LOCAL_POSTGRES_PORT=55432
LOCAL_REDIS_PORT=56379
LOCAL_MINIO_PORT=9000
LOCAL_MINIO_CONSOLE_PORT=9090
LOCAL_CHROME_PORT=3003

# Application
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
EXPERT_DASHBOARD_URL=http://localhost:3001/collab-meetings
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
APP_RELEASE=local
ENVIRONMENT=development
REGISTRY_URL=
NGINX_PORT=4000
NGINX_EXPERT_PORT=4001
NGINX_ADMIN_PORT=4002
CHROME_WS_URL=ws://localhost:3003

# Authentication
JWT_SECRET=local-development-access-token-secret-change-outside-local-docker
JWT_REFRESH_SECRET=local-development-refresh-token-secret-change-outside-local-docker

# AI providers
OPENAI_API_KEY=
GEMINI_API_KEY=

# Email
SENDER_EMAIL=no-reply@localhost
SENDER_PASSWORD=
SMTP_PORT=587
SMTP_SERVER=
SMTP_SECURE=false

# Jitsi
JITSI_APP_DOMAIN=8x8.vc
JITSI_APP_ID=local-jitsi-app
JAAS_API_KEY_ID=local-jitsi-key
JITSI_PRIVATE_KEY_PATH=src/assets/jitsi-private-key.pk

# PostgreSQL
PGDATABASE=oxusedu
PGHOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-postgres-password
POSTGRES_PORT=55432
DATABASE_URL=postgresql://postgres:local-postgres-password@localhost:55432/oxusedu

# Redis
REDIS_HOST=localhost
REDIS_PORT=56379
REDIS_PASSWORD=local-redis-password
REDIS_URL=redis://:local-redis-password@localhost:56379

# S3-compatible storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local-minio
AWS_S3_BUCKET_NAME=uploads
AWS_BUCKET_NAME=uploads
AWS_SECRET_ACCESS_KEY=local-minio-password
AWS_MINIO_ENDPOINT=http://localhost:9000
AWS_MINIO_PUBLIC_URL=http://localhost:9000

# Freedom Pay
FREEDOM_API_URL=
FREEDOM_MERCHANT_ID=
FREEDOM_RECEIVE_SECRET_KEY=
FREEDOM_PAYMENT_SECRET_KEY=
FREEDOM_RESULT_URL=http://localhost:4000/api/v1/billing/result
FREEDOM_FAILURE_URL=http://localhost:3000/payment/failure
FREEDOM_SUCCESS_URL=http://localhost:3000/payment/success

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
