{
  "info": {
    "_postman_id": "7c120fc3-6d9d-4b31-b8a4-bd47e705f5db",
    "name": "Oxus Backend — Sales Manager CRM",
    "description": "REST-контракт новой CRM для Sales Manager, публичного калькулятора, кабинета эксперта и уведомлений.\n\nРекомендуемый порядок: Authentication → Public lead ingestion → Sales leads → Callbacks или Expert calls → Expert cabinet → Notifications.\n\nКоллекция автоматически сохраняет accessToken, leadId, callbackId, expertUserId, expertCallId и notificationId. Перед запуском задайте salesEmail/salesPassword и expertEmail/expertPassword в окружении. Даты callback и созвона формируются автоматически.\n\nWebSocket работает отдельно через Socket.IO namespace /sales; после reconnect клиент обязан повторно загрузить REST-список.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function setIfEmpty(name, value) {",
          "  if (!pm.collectionVariables.get(name)) pm.collectionVariables.set(name, value);",
          "}",
          "",
          "setIfEmpty('submissionId', pm.variables.replaceIn('{{$guid}}'));",
          "",
          "const callbackAt = new Date(Date.now() + 24 * 60 * 60 * 1000);",
          "callbackAt.setUTCSeconds(0, 0);",
          "callbackAt.setUTCMinutes(Math.ceil(callbackAt.getUTCMinutes() / 15) * 15);",
          "setIfEmpty('callbackAt', callbackAt.toISOString());",
          "",
          "const callStartAt = new Date(Date.now() + 48 * 60 * 60 * 1000);",
          "callStartAt.setUTCSeconds(0, 0);",
          "callStartAt.setUTCMinutes(Math.ceil(callStartAt.getUTCMinutes() / 30) * 30);",
          "setIfEmpty('callStartAt', callStartAt.toISOString());",
          "setIfEmpty('callEndAt', new Date(callStartAt.getTime() + 30 * 60 * 1000).toISOString());",
          "",
          "const fromDate = new Date();",
          "const toDate = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000);",
          "setIfEmpty('fromDate', fromDate.toISOString().slice(0, 10));",
          "setIfEmpty('toDate', toDate.toISOString().slice(0, 10));"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "https://test.oxusedu.com/api/v1", "type": "string" },
    { "key": "salesEmail", "value": "", "type": "string" },
    { "key": "salesPassword", "value": "", "type": "string" },
    { "key": "expertEmail", "value": "", "type": "string" },
    { "key": "expertPassword", "value": "", "type": "string" },
    { "key": "salesAccessToken", "value": "", "type": "string" },
    { "key": "expertAccessToken", "value": "", "type": "string" },
    { "key": "submissionId", "value": "", "type": "string" },
    { "key": "leadId", "value": "", "type": "string" },
    { "key": "callbackId", "value": "", "type": "string" },
    { "key": "expertUserId", "value": "", "type": "string" },
    { "key": "expertCallId", "value": "", "type": "string" },
    { "key": "notificationId", "value": "", "type": "string" },
    { "key": "callbackAt", "value": "", "type": "string" },
    { "key": "callStartAt", "value": "", "type": "string" },
    { "key": "callEndAt", "value": "", "type": "string" },
    { "key": "fromDate", "value": "", "type": "string" },
    { "key": "toDate", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "00 — Authentication",
      "item": [
        {
          "name": "Sign in — Sales Manager",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{salesEmail}}\",\n  \"password\": \"{{salesPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/sign-in",
            "description": "Сохраняет accessToken Sales Manager в переменную salesAccessToken."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "pm.expect(body.user.role.code).to.eql('SALES_MANAGER');",
                  "pm.collectionVariables.set('salesAccessToken', body.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in — Expert",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{expertEmail}}\",\n  \"password\": \"{{expertPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/sign-in",
            "description": "Сохраняет accessToken эксперта в переменную expertAccessToken."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "pm.expect(body.user.role.code).to.eql('EXPERT');",
                  "pm.collectionVariables.set('expertAccessToken', body.accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 — Public landing calculator",
      "item": [
        {
          "name": "Submit landing lead",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"submissionId\": \"{{submissionId}}\",\n  \"quizVersion\": \"2026-08-26\",\n  \"submittedAt\": \"{{$isoTimestamp}}\",\n  \"role\": \"parent\",\n  \"locale\": \"kk\",\n  \"name\": \"Аружан Сейдахмет\",\n  \"phone\": \"+7 777 482 19 33\",\n  \"score\": 935,\n  \"percent\": 93,\n  \"universities\": 50,\n  \"answers\": [\n    {\n      \"questionId\": \"city\",\n      \"optionIds\": [\"almaty\"],\n      \"freeText\": null,\n      \"questionText\": \"Из какого вы города?\",\n      \"answerText\": \"Алматы\"\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/public/lead-sources/landing-calculator/submissions",
            "description": "Публичный endpoint, 30 запросов/мин на IP. submissionId — UUID идемпотентности. Калькуляцию backend не выполняет."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.expect(body.leadId).to.be.a('number');",
                  "pm.expect(body.created).to.be.a('boolean');",
                  "pm.collectionVariables.set('leadId', String(body.leadId));"
                ]
              }
            }
          ]
        },
        {
          "name": "Repeat same submission — idempotency",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"submissionId\": \"{{submissionId}}\",\n  \"quizVersion\": \"2026-08-26\",\n  \"submittedAt\": \"{{$isoTimestamp}}\",\n  \"role\": \"parent\",\n  \"locale\": \"kk\",\n  \"name\": \"Аружан Сейдахмет\",\n  \"phone\": \"+7 777 482 19 33\",\n  \"score\": 935,\n  \"percent\": 93,\n  \"universities\": 50,\n  \"answers\": [{ \"question\": \"Из какого вы города?\", \"answer\": \"Алматы\" }]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/public/lead-sources/landing-calculator/submissions",
            "description": "Повтор с тем же submissionId должен вернуть тот же leadId и created=false."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.expect(body.created).to.eql(false);",
                  "pm.expect(String(body.leadId)).to.eql(pm.collectionVariables.get('leadId'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 — Sales leads",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{salesAccessToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "List visible leads",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/sales/leads?status=NEW&page=1&limit=10",
            "description": "NEW показывает общие нераспределённые лиды и NEW-лиды текущего менеджера. Другие статусы — только собственные. Дополнительно: source и search."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.expect(body.data).to.be.an('array');", "pm.expect(body.meta).to.be.an('object');"] } }]
        },
        {
          "name": "Lead summary",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/sales/leads/summary" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Lead sources",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/sales/lead-sources" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json()).to.be.an('array');"] } }]
        },
        {
          "name": "Create manual office lead",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Марат Тестов\",\n  \"phone\": \"+7 701 123 45 67\",\n  \"email\": \"marat@example.com\",\n  \"role\": \"student\",\n  \"locale\": \"ru\",\n  \"answers\": [\n    {\n      \"questionId\": \"office-note\",\n      \"freeText\": \"Пришел в офис с родителем\",\n      \"questionText\": \"Комментарий\",\n      \"answerText\": \"Пришел в офис с родителем\"\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/sales/leads",
            "description": "Создаёт общий нераспределённый лид. Создавший Sales Manager не становится ответственным автоматически."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.expect(body.lead.id).to.be.a('number');",
                  "pm.collectionVariables.set('leadId', String(body.lead.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Accept lead",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/sales/leads/{{leadId}}/accept",
            "description": "Атомарно закрепляет общий NEW lead за текущим Sales Manager. Повторное принятие возвращает 409."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.expect(String(body.id)).to.eql(pm.collectionVariables.get('leadId'));"] } }]
        },
        {
          "name": "Get lead detail",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/sales/leads/{{leadId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.expect(String(body.id)).to.eql(pm.collectionVariables.get('leadId'));"] } }]
        },
        {
          "name": "Get lead activities",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/sales/leads/{{leadId}}/activities" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json()).to.be.an('array');"] } }]
        },
        {
          "name": "Reject owned lead",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Клиент больше не заинтересован\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/sales/leads/{{leadId}}/reject",
            "description": "Терминальный сценарий. Запускайте на отдельном принятом lead, если после этого хотите продолжать остальные сценарии коллекции."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 201 or 200', () => pm.expect([200, 201]).to.include(pm.response.code));", "pm.expect(pm.response.json().status).to.eql('REJECTED');"] } }]
        }
      ]
    },
    {
      "name": "03 — Callbacks",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{salesAccessToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "Schedule callback",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"scheduledFor\": \"{{callbackAt}}\",\n  \"comment\": \"Перезвонить и уточнить удобное время\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/sales/leads/{{leadId}}/callbacks",
            "description": "Требуется собственный лид. Время — будущее ISO-8601 строго на 15-минутной границе."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.expect(body.callback.id).to.be.a('number');",
                  "pm.collectionVariables.set('callbackId', String(body.callback.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reschedule callback",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"scheduledFor\": \"{{callbackAt}}\",\n  \"comment\": \"Время подтверждено\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/sales/leads/{{leadId}}/callbacks/{{callbackId}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().callback.status).to.eql('SCHEDULED');"] } }]
        },
        {
          "name": "Complete callback",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"COMPLETED\",\n  \"comment\": \"Созвон завершён\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/sales/leads/{{leadId}}/callbacks/{{callbackId}}",
            "description": "После COMPLETED callback неизменяем, а лид возвращается в NEW и остаётся у текущего менеджера. Для отмены используйте CANCELLED."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.expect(body.callback.status).to.eql('COMPLETED');", "pm.expect(body.lead.status).to.eql('NEW');"] } }]
        }
      ]
    },
    {
      "name": "04 — Sales: experts and calls",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{salesAccessToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "List active experts",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/sales/experts?page=1&limit=20" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.data).to.be.an('array');",
                  "if (body.data.length) pm.collectionVariables.set('expertUserId', String(body.data[0].expertUserId));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get expert available slots",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/experts/{{expertUserId}}/available-slots?from={{fromDate}}&to={{toDate}}",
            "description": "Диапазон не более 62 дней. Слоты уже учитывают консультации и активные Sales-запросы. Перед созданием call подставьте один из реально доступных интервалов в callStartAt/callEndAt."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json()).to.be.an('array');"] } }]
        },
        {
          "name": "Request expert call",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"expertUserId\": {{expertUserId}},\n  \"startTime\": \"{{callStartAt}}\",\n  \"endTime\": \"{{callEndAt}}\",\n  \"comment\": \"Первичная консультация по поступлению\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/sales/leads/{{leadId}}/expert-calls",
            "description": "Интервал должен быть доступен у эксперта, начинаться минимум через 4 часа и не пересекаться с Consultation/LeadExpertCall."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.expect(body.id).to.be.a('number');",
                  "pm.expect(body.status).to.eql('REQUESTED');",
                  "pm.collectionVariables.set('expertCallId', String(body.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update pending expert call",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"comment\": \"Обновлённый комментарий до ответа эксперта\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/sales/leads/{{leadId}}/expert-calls/{{expertCallId}}",
            "description": "Менять можно только REQUESTED-запрос. После confirm/decline endpoint вернёт 409."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().status).to.eql('REQUESTED');"] } }]
        }
      ]
    },
    {
      "name": "05 — Expert cabinet",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{expertAccessToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "Pending lead calls",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/expert/lead-calls/pending", "description": "Полный список REQUESTED без пагинационного отсечения, по startTime ASC." },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body).to.be.an('array');",
                  "if (body.length) pm.collectionVariables.set('expertCallId', String(body[0].id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Lead call history",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/expert/lead-calls?page=1&limit=20", "description": "Опциональный status: REQUESTED, CONFIRMED, DECLINED, CANCELLED." },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.expect(body.data).to.be.an('array');"] } }]
        },
        {
          "name": "Lead call detail",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/expert/lead-calls/{{expertCallId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get('expertCallId'));"] } }]
        },
        {
          "name": "Confirm lead call",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"action\": \"confirm\",\n  \"comment\": \"Подтверждаю время\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/expert/lead-calls/{{expertCallId}}/respond",
            "description": "Создаёт Meeting и возвращает LeadExpertCall со status=CONFIRMED и meetingId. Для отказа используйте action=decline."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.expect(body.status).to.eql('CONFIRMED');", "pm.expect(body.meetingId).to.be.a('number');"] } }]
        },
        {
          "name": "Decline lead call",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"action\": \"decline\",\n  \"comment\": \"В это время занят\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/expert/lead-calls/{{expertCallId}}/respond",
            "description": "Альтернативный терминальный сценарий. Запускайте вместо Confirm для другого REQUESTED-запроса."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().status).to.eql('DECLINED');"] } }]
        }
      ]
    },
    {
      "name": "06 — Notifications",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{salesAccessToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "List notifications",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/notifications?page=1&limit=20&unreadOnly=false", "description": "По умолчанию используется Sales token. Чтобы проверить уведомления эксперта, временно замените token folder на {{expertAccessToken}}." },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.data).to.be.an('array');",
                  "if (body.data.length) pm.collectionVariables.set('notificationId', String(body.data[0].id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unread count",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/notifications/unread-count" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Mark one as read",
          "request": { "method": "PATCH", "header": [], "url": "{{baseUrl}}/notifications/{{notificationId}}/read" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().readAt).to.be.a('string');"] } }]
        },
        {
          "name": "Mark all as read",
          "request": { "method": "PATCH", "header": [], "url": "{{baseUrl}}/notifications/read-all" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().updated).to.be.a('number');"] } }]
        }
      ]
    },
    {
      "name": "07 — Negative/edge checks",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{salesAccessToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "Accept same lead again — expect 409",
          "request": { "method": "POST", "header": [], "url": "{{baseUrl}}/sales/leads/{{leadId}}/accept" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 409', () => pm.response.to.have.status(409));"] } }]
        },
        {
          "name": "Invalid landing phone — expect 400",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"submittedAt\": \"{{$isoTimestamp}}\",\n  \"role\": \"parent\",\n  \"locale\": \"ru\",\n  \"name\": \"Некорректный телефон\",\n  \"phone\": \"call-me\",\n  \"score\": 1,\n  \"percent\": 1,\n  \"universities\": 1,\n  \"answers\": [{ \"question\": \"Город\", \"answer\": \"Алматы\" }]\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/public/lead-sources/landing-calculator/submissions"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"] } }]
        },
        {
          "name": "Edit completed callback — expect 409",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"comment\": \"Эта правка должна быть отклонена\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/sales/leads/{{leadId}}/callbacks/{{callbackId}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 409', () => pm.response.to.have.status(409));"] } }]
        }
      ]
    }
  ]
}
